# Virtual environment
venv/
__pycache__/
*.pyc

# Derived data: regenerated by the scripts, not versioned.
# data/raw/ IS versioned: it is the source of truth.
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Audit reports and the changelog ARE versioned (traceability),
# but generated figures are not.
reports/figures/*
!reports/figures/.gitkeep
